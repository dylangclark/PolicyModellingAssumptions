# Required for the complete phase-one release (used by the EIA adapter).
EIA_API_KEY=

# Optional path overrides. Relative paths are resolved from the repository root.
BC_ASSUMPTIONS_DB=state/registry.sqlite
BC_ASSUMPTIONS_RAW_DIR=data/raw
BC_ASSUMPTIONS_EXPORT_DIR=data/export
BC_ASSUMPTIONS_SITE_DATA_DIR=site/data

# Used in HTTP request identification. Replace with a monitored address.
BC_ASSUMPTIONS_CONTACT=registry-operator@example.org

# Optional Git settings used by scripts/run_weekly.sh.
BC_ASSUMPTIONS_GIT_BRANCH=main
BC_ASSUMPTIONS_GIT_REMOTE=origin

# Commit identity used by scripts/run_weekly.sh.
BC_ASSUMPTIONS_GIT_NAME=BC Assumptions Bot
BC_ASSUMPTIONS_GIT_EMAIL=bc-assumptions-bot@users.noreply.github.com

# Set to 1 only while diagnosing a failed source.
BC_ASSUMPTIONS_DEBUG=0
